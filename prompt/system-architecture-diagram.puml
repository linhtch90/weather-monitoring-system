@startuml system-architecture-diagram
skinparam backgroundColor #F8FAFC
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans, Segoe UI, Roboto, Helvetica, Arial, sans-serif"
skinparam defaultFontColor #0F172A
skinparam defaultFontSize 12
skinparam roundCorner 12
skinparam shadowing true
skinparam nodesep 55
skinparam ranksep 65
skinparam packageStyle rectangle

skinparam title {
  FontColor #0F172A
  FontSize 20
  FontStyle bold
  BackgroundColor #E2E8F0
  BorderColor #334155
  BorderThickness 1.5
  BorderRoundCorner 10
}

skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
  FontSize 12
}

skinparam package {
  FontColor #0F172A
  BorderColor #475569
  FontSize 14
  FontStyle bold
  BorderThickness 2
}

skinparam component {
  FontColor #0F172A
  BorderColor #1E293B
  FontSize 12
  BorderThickness 1.5
}

skinparam database {
  FontColor #0F172A
  BorderColor #0F766E
  FontSize 12
  BorderThickness 1.5
}

skinparam queue {
  FontColor #0F172A
  BorderColor #C2410C
  FontSize 12
  BorderThickness 1.5
}

skinparam arrow {
  Color #334155
  FontColor #0F172A
  FontSize 11
  Thickness 2
}

title <&cloud> CLOUD-NATIVE WEATHER TELEMETRY MONITORING ARCHITECTURE\n<size:13><color:#334155>High-Throughput Ingestion  •  Direct gRPC  •  Asynchronous RabbitMQ  •  TimescaleDB  •  Dynamic 60x Frequency Feedback  •  100% Open Source</color></size>

' ==================== TIER 1: EDGE CLIENT FLEET ====================
package "1. Edge Client Fleet (Thousands of Stations)" as Tier1 #E2E8F0 {
  component EdgeStations #BAE6FD [
    <&wifi> **Weather Monitoring Stations (Fleet)**
    ....
    • **Baseline**: 1 req / 60s
    • **Severe Storm Burst**: 1 req / 1s (60x Surge)
    • **Protocols**: HTTP/2 gRPC & HTTP/1.1 REST
  ]
  component Scientists #E9D5FF [
    <&person> **Scientists & Meteorological Ops**
    ....
    • Dynamic frequency override commands
    • Station registration & threshold tuning
  ]
}

' ==================== TIER 7: OBSERVABILITY & VERIFICATION ====================
package "7. Observability, Load Testing & Chaos Engineering Harness" as Tier7 #E2E8F0 {
  component PromGrafana #F1F5F9 [
    <&graph> **Prometheus + Grafana**
    ....
    • Golden Signals & Latency
    • Queue depth & batch metrics
  ]
  component K6Suite #FEF08A [
    <&fire> **Grafana k6 Load Suite**
    ....
    • 60x Dynamic Spike (1,200 req/s)
    • Fleet Growth (5,000 stations)
  ]
  component ChaosSuite #FECDD3 [
    <&shield> **Chaos Engineering Suite**
    ....
    • Station outage circuit breaker test
    • Poison pill & DLQ isolation test
  ]
}

' ==================== TIER 2: INGESTION GATEWAY & AUTH CACHE ====================
package "2. Ingestion Gateway Tier (High-Throughput)" as Tier2 #E0F2FE {
  component IngestionSvc #7DD3FC [
    <&bolt> **Ingestion Gateway Service**
    //(apps/ingestion-service • NestJS)//
    ....
    • **Dual Ingress**: REST (:3000) & gRPC (:50052)
    • **Sanity Check**: Physical sensor bounds (< 15ms)
    • **Resilience**: Opossum Circuit Breaker + Regex Fallback
    • **Autoscaling**: Kubernetes HPA (3 → 25 pods)
  ]
  database RedisCache #FCA5A5 [
    <&key> **Redis 7.2 Cache**
    ....
    • Station Token Auth
    • Cache-Aside (5m TTL)
    • Sub-millisecond lookup
  ]
}

' ==================== TIER 3: STATION MANAGEMENT (DIRECT gRPC) ====================
package "3. Station Management Tier (Direct gRPC)" as Tier3 #DBEAFE {
  component StationSvc #93C5FD [
    <&cog> **Station Service**
    //(apps/station-service • gRPC :50051)//
    ....
    • **Contract**: Protobuf (station.proto)
    • **RPCs**: ValidateStation() & GetStationConfig()
    • **Control**: UpdateReportingFrequency(1s / 60s)
    • **Persistence**: TypeORM + In-Memory Fallback
  ]
  database PostgresDB #99F6E4 [
    <&hard-drive> **PostgreSQL 16**
    ....
    • stations table (TypeORM)
    • Geo coordinates & elevation
    • Active frequency state
  ]
}

' ==================== TIER 4: RABBITMQ BROKER ====================
package "4. RabbitMQ Message Broker (Asynchronous Decoupling & Backpressure)" as Tier4 #FFEDD5 {
  queue TopicEx #FDBA74 [
    <&fork> **Topic Exchange**
    **weather.telemetry.topic**
    ....
    • Key: telemetry.raw.<region>.<id>
    • Publisher Confirms: ENABLED
  ]
  queue RawQueue #FED7AA [
    <&layers> **Durable Telemetry Queue**
    **weather.raw.telemetry**
    ....
    • Absorbs 60x storm traffic spikes
    • Consumer Prefetch Limit: 200
    • Manual Ack on DB commit
  ]
  queue DLQ #FDA4AF [
    <&warning> **Dead Letter Exchange & Queue (DLX / DLQ)**
    **weather.telemetry.dlx → weather.telemetry.dlq**
    ....
    • Isolates corrupted payloads & poison pills via nack(requeue=false)
  ]
}

' ==================== TIER 5: PROCESSING & TIMESCALEDB TIER ====================
package "5. Processing & Analytics Tier (Micro-Batching & Time-Series Storage)" as Tier5 #E0E7FF {
  component KedaScaler #E9D5FF [
    <&dashboard> **KEDA Autoscaler**
    ....
    • Polls RabbitMQ QueueLength
    • Threshold: 500 msgs / pod
    • Scales 2 → 20 replicas
  ]
  component ProcessingSvc #C7D2FE [
    <&pulse> **Processing Service**
    //(apps/processing-service • NestJS Worker)//
    ....
    • **Micro-Batching**: 500 rows OR 250ms flush
    • **High-Speed I/O**: Raw pg.Pool multi-row INSERTs
    • **AnomalyDetector**: Sliding-window check
      (ΔP > 3 hPa, ΔT > 5°C, Wind > 28 m/s)
  ]
  database TimescaleDB #99F6E4 [
    <&timer> **TimescaleDB (PG 16)**
    ....
    • **Hypertable**: weather_metrics
    • 1-Day chunk partitioning
    • Continuous aggregates
      (weather_metrics_hourly)
    • 7-Day compression policy
  ]
}

' ==================== TIER 6: DYNAMIC CONTROL & ALERTING ====================
package "6. Dynamic Feedback Loop & Alerting Tier" as Tier6 #FEE2E2 {
  component AlertingSvc #FCA5A5 [
    <&bell> **Alerting & Control Service**
    //(apps/alerting-service • NestJS Worker + gRPC Client)//
    ....
    • Consumes **weather.anomaly.detected** events from RabbitMQ
    • Triggers gRPC **UpdateReportingFrequency(1s)** to Station Service
    • Protected by Opossum Circuit Breaker
  ]
}

' ==================== CONNECTIONS ====================
EdgeStations -down[#0284C7,bold]-> IngestionSvc : "1. Telemetry Stream\n(gRPC :50052 / HTTP :3000)"
Scientists -down[#7E22CE,dashed]-> StationSvc : "Manual Override (gRPC)"

K6Suite -down[#D97706,dotted]-> IngestionSvc : "60x Load Test"
ChaosSuite -down[#E11D48,dotted]-> IngestionSvc : "Fault Injection"

IngestionSvc <-right[#DC2626,bold]-> RedisCache : "2a. Cache-Aside\nAuth Check (<1ms)"
IngestionSvc -left[#1D4ED8,dashed,bold]-> StationSvc : "2b. Direct gRPC (Cache Miss)\nValidateStation() [Circuit Breaker]"
StationSvc <-right[#0D9488,bold]-> PostgresDB : "TypeORM\nRepository"

IngestionSvc -down[#EA580C,bold]-> TopicEx : "3. AMQP Publish\n(Publisher Confirms <15ms)"
TopicEx -down[#EA580C,bold]-> RawQueue : "Route: telemetry.raw.*.*"
RawQueue -down[#E11D48,dashed]-> DLQ : "Poison Pill: nack(requeue=false)"

RawQueue -left[#EA580C,bold]-> ProcessingSvc : "4. Consume Stream\n(Prefetch: 200, Manual Ack)"
KedaScaler -down[#7E22CE,dashed]-> ProcessingSvc : "Scales Replicas\n(QueueLength > 500)"
ProcessingSvc -right[#0D9488,bold]-> TimescaleDB : "5. Batch INSERT via pg.Pool\n(500 rows / 250ms)"

ProcessingSvc -up[#DC2626,dashed,bold]-> TopicEx : "6. Publish Anomaly\n(weather.anomaly.detected)"
TopicEx -up[#DC2626,dashed,bold]-> AlertingSvc : "Consume Anomaly\n(weather.alerts)"
AlertingSvc -up[#DC2626,dashed,bold]-> StationSvc : "7. Dynamic Loop (gRPC)\nUpdateReportingFrequency(1s)"
StationSvc -up[#7E22CE,dashed]-> EdgeStations : "8. Command Ack\nSwitch 60s → 1s Mode"

legend bottom right
  |<#93C5FD> <color:#1E3A8A>**Blue Dashed**</color> | **Direct Synchronous gRPC** (HTTP/2 Binary Protobuf + Opossum Circuit Breaker) |
  |<#FDBA74> <color:#9A3412>**Orange Solid**</color> | **Asynchronous RabbitMQ** (Topic Exchange, Publisher Confirms, Prefetch Backpressure) |
  |<#99F6E4> <color:#115E59>**Teal Solid**</color> | **Database / Cache I/O** (TimescaleDB Batch pg.Pool, PostgreSQL TypeORM, Redis Cache) |
  |<#FCA5A5> <color:#991B1B>**Red Dashed**</color> | **Dynamic 60x Storm Feedback Loop** (AnomalyDetector → AlertingService → 1s Frequency) |
  |<#FDA4AF> <color:#9F1239>**Rose Dashed**</color> | **Dead-Letter Queue Isolation** (weather.telemetry.dlx → weather.telemetry.dlq) |
  |<#E9D5FF> <color:#581C87>**Purple Dashed**</color> | **KEDA Queue-Depth Horizontal Autoscaling** (2 → 20 Replicas) |
endlegend
@enduml
