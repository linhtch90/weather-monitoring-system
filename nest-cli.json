{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ingestion-service/src",
  "monorepo": true,
  "root": "apps/ingestion-service",
  "compilerOptions": {
    "assets": [
      {
        "include": "**/*.proto",
        "watchAssets": true
      }
    ]
  },
  "projects": {
    "ingestion-service": {
      "type": "application",
      "root": "apps/ingestion-service",
      "entryFile": "main",
      "sourceRoot": "apps/ingestion-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingestion-service/tsconfig.app.json",
        "assets": [
          {
            "include": "../../libs/contracts/src/proto/*.proto",
            "outDir": "dist/apps/ingestion-service/libs/contracts/src/proto",
            "watchAssets": true
          }
        ]
      }
    },
    "station-service": {
      "type": "application",
      "root": "apps/station-service",
      "entryFile": "main",
      "sourceRoot": "apps/station-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/station-service/tsconfig.app.json",
        "assets": [
          {
            "include": "../../libs/contracts/src/proto/*.proto",
            "outDir": "dist/apps/station-service/libs/contracts/src/proto",
            "watchAssets": true
          }
        ]
      }
    },
    "processing-service": {
      "type": "application",
      "root": "apps/processing-service",
      "entryFile": "main",
      "sourceRoot": "apps/processing-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/processing-service/tsconfig.app.json"
      }
    },
    "alerting-service": {
      "type": "application",
      "root": "apps/alerting-service",
      "entryFile": "main",
      "sourceRoot": "apps/alerting-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/alerting-service/tsconfig.app.json",
        "assets": [
          {
            "include": "../../libs/contracts/src/proto/*.proto",
            "outDir": "dist/apps/alerting-service/libs/contracts/src/proto",
            "watchAssets": true
          }
        ]
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json",
        "assets": [
          {
            "include": "proto/*.proto",
            "watchAssets": true
          }
        ]
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "rabbitmq": {
      "type": "library",
      "root": "libs/rabbitmq",
      "entryFile": "index",
      "sourceRoot": "libs/rabbitmq/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rabbitmq/tsconfig.lib.json"
      }
    }
  }
}
